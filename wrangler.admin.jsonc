
{
  "name": "nour-os-admin",
  "main": "src/admin-worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./admin-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nour-os-db",
      "database_id": "4277e4c9-d86d-47fc-aa1c-743faee98619"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nour-os-files"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "frosty-leaf-3e6c.cloudflareaccess.com",
    "ACCESS_AUD": "97c660b290b5f78b15c4aebb040f81595677b36ed47261d39e5cc16174eccbbc",
    "ADMIN_EMAIL": "nourkhatar55@gmail.com"
  }
}
