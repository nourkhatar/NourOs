{
  "name": "nour-os-admin",
  "main": "src/admin-worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./admin-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nour-os-db",
      "database_id": "4277e4c9-d86d-47fc-aa1c-743faee98619"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nour-os-files"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_YOUR_ACCESS_APPLICATION_AUD",
    "ADMIN_EMAIL": "REPLACE_WITH_YOUR_EMAIL"
  }
}
