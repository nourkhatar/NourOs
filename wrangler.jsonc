{
  "name": "nour-os",
  "main": "src/public-worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nour-os-db",
      "database_id": "4277e4c9-d86d-47fc-aa1c-743faee98619"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nour-os-files"
    }
  ]
}
